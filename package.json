{
  "name": "mwbot",
  "version": "2.4.0",
  "description": "A simple, flexible MediaWiki Bot",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "p-map": "^7.1.1",
    "semlog": "^1.0.0",
    "semver": "^7.3.8",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^10.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "prettier": "^3.0.0"
  },
  "scripts": {
    "lint": "eslint src/ test/",
    "format:check": "prettier --check src/ test/",
    "test": "mocha 'test/unit/**/*.spec.js' 'test/integration/**/*.spec.js'",
    "test:unit": "mocha 'test/unit/**/*.spec.js'",
    "test:integration": "mocha 'test/integration/**/*.spec.js'",
    "test:external": "mocha 'test/external/**/*.spec.js'",
    "test:coverage": "c8 mocha 'test/unit/**/*.spec.js' 'test/integration/**/*.spec.js'"
  },
  "mocha": {
    "import": [
      "./test/helpers/setup.js"
    ],
    "timeout": 16000,
    "reporter": "spec"
  },
  "c8": {
    "check-coverage": true,
    "lines": 88,
    "statements": 88,
    "branches": 85,
    "functions": 75,
    "reporter": [
      "lcov",
      "text",
      "clover"
    ],
    "include": [
      "src/**"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gesinn-it-pub/mwbot.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "MediaWiki",
    "Bot",
    "Upload",
    "API",
    "Promises",
    "MW"
  ],
  "author": {
    "name": "Simon Heimler",
    "mail": "heimlersimon@gmail.com",
    "url": "http://www.fannon.de"
  },
  "contributors": [
    {
      "name": "gesinn.it GmbH & Co. KG",
      "email": "github@gesinn.it",
      "url": "https://gesinn.it"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gesinn-it-pub/mwbot/issues"
  },
  "homepage": "https://github.com/gesinn-it-pub/mwbot#readme"
}
